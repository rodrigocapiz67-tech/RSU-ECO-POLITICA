# Panel de Supabase > Project Settings > API
# El project-ref para `supabase link --project-ref <ref>` es el subdominio de esta URL
# (ej. https://cwfsxwayjxsipwqejmrd.supabase.co -> ref = cwfsxwayjxsipwqejmrd).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key

# Panel de Supabase > Project Settings > API > "service_role" (secreto, NUNCA exponer al cliente)
# Los repositorios NO usan esta key: usan el cliente atado a cookies (respeta RLS).
# Esta key solo la necesitas si agregas jobs/tooling server-side que deban saltarse RLS a propósito.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Rate Limiting Distribuido (Upstash Redis) - REQUERIDO para producción
# En local sin Redis, usa fallback en-memoria (solo válido para 1 instancia)
# Crear en: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://tu-cluster.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu-token-redis
