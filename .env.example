# Panel de Supabase > Project Settings > API
# El project-ref para `supabase link --project-ref <ref>` es el subdominio de esta URL
# (ej. https://cwfsxwayjxsipwqejmrd.supabase.co -> ref = cwfsxwayjxsipwqejmrd).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key

# Panel de Supabase > Project Settings > API > "service_role" (secreto, NUNCA exponer al cliente)
# Los repositorios lo usan server-side para saltar RLS; la autorización se valida en las API routes.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
